{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Generate API version file",
            "type": "shell",
            "command": "make generate-version-file",
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "Generate API Python requirements_nl.in",
            "type": "shell",
            "command": "uv pip compile requirements_nl.in -o requirements_nl.txt ",
            "dependsOn": [],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            },
            "options": {
                "env": {
                    "UV_LINK_MODE": "copy"
                }
            }
        },
        {
            "label": "Generate API Python requirements_nl_test.in",
            "type": "shell",
            "command": "uv pip compile requirements_nl_test.in -o requirements_nl_test.txt ",
            "dependsOn": ["Generate API Python requirements_nl.in"],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            },
            "options": {
                "env": {
                    "UV_LINK_MODE": "copy"
                }
            }
        },
        {
            "label": "Install API Python requirements",
            "type": "shell",
            "command": "uv pip install -r requirements_nl_test.txt",
            "dependsOn": ["Generate API version file", "Generate API Python requirements_nl_test.in"],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            },
            "options": {
                "env": {
                    "UV_LINK_MODE": "copy"
                }
            }
        },
        {
            "label": "Install API local notifynl-utils",
            "type": "shell",
            "command": "CHOICE=$(cat /workspace/.local-editables-choice 2>/dev/null || echo No); if [ \"$CHOICE\" = \"Yes\" ]; then uv pip uninstall notifications-utils && uv pip install -e ../notifynl-utils; fi",
            "dependsOn": ["Deactivate Spryng provider"],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            },
            "options": {
                "env": {
                    "UV_LINK_MODE": "copy"
                }
            }
        },
        {
            "label": "Run GOV.UK migrations",
            "type": "shell",
            "command": "set -a && source .env && .venv/bin/python -m flask db upgrade",
            "problemMatcher": "$python",
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "Run NOTIFYNL migrations",
            "type": "shell",
            "command": "set -a && source .env && .venv/bin/python -m flask db upgrade -d migrations_nl",
            "problemMatcher": "$python",
            "dependsOn": ["Run GOV.UK migrations"],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "API pre-launch",
            "type": "shell",
            "command": "echo \"API pre-launch\"",
            "dependsOn": [
                "Install API local notifynl-utils",
                "Run NOTIFYNL migrations"
            ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "API pre-launch (non-local)",
            "type": "shell",
            "command": "echo \"API pre-launch\"",
            "dependsOn": [
                "Install API Python requirements",
            ],
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        },
        // Flask commands
        {
            "label": "API functional test fixtures",
            "type": "shell",
            "command": ".venv/bin/python -m flask command functional-test-fixtures",
            "problemMatcher": "$python",
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "Create Platform Admin User",
            "type": "shell",
            "command": ".venv/bin/python -m flask command create-platform-admin -e \"${input:adminEmail}\" -m \"${input:adminPhone}\" -p \"${input:adminPassword}\"",
            "problemMatcher": "$python",
            "presentation": {
                "showReuseMessage": false
            },
            "options": {
                "env": {
                    "FLASK_APP": "application.py"
                }
            }
        },
        {
            "label": "Create Test Service",
            "type": "shell",
            "command": ".venv/bin/python -m flask command create-test-service -u \"${input:userId}\" -n \"${input:serviceName}\"",
            "problemMatcher": "$python",
            "presentation": {
                "showReuseMessage": false
            },
            "options": {
                "env": {
                    "FLASK_APP": "application.py"
                }
            }
        },
        {
            "label": "Create API key",
            "type": "shell",
            "command": ".venv/bin/python -m flask command create-api-key -u \"${input:userId}\" -n \"${input:apiKeyName}\" -s \"${input:serviceId}\" -t \"${input:apiKeyType}\"",
            "problemMatcher": "$python",
            "presentation": {
                "showReuseMessage": false
            },
            "options": {
                "env": {
                    "FLASK_APP": "application.py"
                }
            }
        },
        {
            "label": "Make Service Live",
            "type": "shell",
            "command": ".venv/bin/python -m flask command make-service-live -s \"${input:serviceId}\" -u \"${input:userId}\"",
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false
            },
            "options": {
                "env": {
                    "FLASK_APP": "application.py"
                }
            }
        },
        {
            "label": "Create SMS Template",
            "type": "shell",
            "command": ".venv/bin/python -m flask command create-sms-template -s \"${input:serviceId}\" -u \"${input:userId}\" -n \"${input:smsTemplateName}\"",
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false
            },
            "options": {
                "env": {
                    "FLASK_APP": "application.py"
                }
            }
        },
        {
            "label": "Create Email Template",
            "type": "shell",
            "command": ".venv/bin/python -m flask command create-email-template -s \"${input:serviceId}\" -u \"${input:userId}\" -n \"${input:emailTemplateName}\"",
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false
            },
            "options": {
                "env": {
                    "FLASK_APP": "application.py"
                }
            }
        },
        {
            "label": "Create NL migration (autogenerate)",
            "type": "shell",
            "command": "set -a && source .env && .venv/bin/python -m flask db migrate -d migrations_nl --rev-id ${input:nlMigrationRevisionId} -m \"${input:nlMigrationDescription}\"",
            "problemMatcher": "$python",
            "presentation": {
                "showReuseMessage": false
            }
        },
        {
            "label": "Create NL migration (blank revision)",
            "type": "shell",
            "command": "set -a && source .env && .venv/bin/python -m flask db revision -d migrations_nl --rev-id ${input:nlMigrationRevisionId} -m \"${input:nlMigrationDescription}\"",
            "problemMatcher": "$python",
            "presentation": {
                "showReuseMessage": false
            }
        },
        {
            "label": "Compile NL requirements",
            "type": "shell",
            "command": "uv pip compile requirements_nl.in -o requirements_nl.txt",
            "problemMatcher": [],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        },
        {
            "label": "Compile NL test requirements",
            "type": "shell",
            "command": "uv pip compile requirements_nl_test.in -o requirements_nl_test.txt",
            "problemMatcher": [],
            "dependsOn": ["Compile NL requirements"],
            "presentation": {
                "showReuseMessage": false,
                "close": true
            }
        }
    ],
    "inputs": [
        {
            "id": "adminEmail",
            "type": "promptString",
            "description": "Enter admin user email address:",
            "default": "admin@example.com"
        },
        {
            "id": "adminPassword",
            "type": "promptString",
            "description": "Enter admin user password:",
            "password": true
        },
        {
            "id": "adminPhone",
            "type": "promptString",
            "description": "Enter admin user phone number:",
        },
        {
            "id": "userId",
            "type": "promptString",
            "description": "Enter user ID:"
        },
        {
            "id": "serviceName",
            "type": "promptString",
            "description": "Enter service name:",
            "default": "Test service"
        },
        {
            "id": "serviceId",
            "type": "promptString",
            "description": "Enter service ID:"
        },
        {
            "id": "apiKeyType",
            "type": "pickString",
            "description": "Select API key type:",
            "options": ["normal", "team", "test"],
        },
        {
            "id": "apiKeyName",
            "type": "promptString",
            "description": "Enter API key name:",
            "default": "Test key"
        },
        {
            "id": "smsTemplateName",
            "type": "promptString",
            "description": "Enter SMS template name:",
            "default": "Test SMS Template"
        },
        {
            "id": "emailTemplateName",
            "type": "promptString",
            "description": "Enter email template name:",
            "default": "Test Email Template"
        },
        {
            "id": "nlMigrationDescription",
            "type": "promptString",
            "description": "Enter NL migration description:"
        },
        {
            "id": "nlMigrationRevisionId",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "max=0; for f in migrations_nl/versions/[0-9][0-9][0-9][0-9]_*.py; do [ -e \"$f\" ] || continue; n=$(basename \"$f\"); n=${n%%_*}; [ \"$n\" -gt \"$max\" ] && max=$n; done; printf '%04d' $((10#$max + 1))",
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
